#!/usr/bin/env python3
"""Ask Jev (TypeSafe's fast classifier) one yes/no routing question about a piece of text.

Usage: jev "<question>" "<when true>" "<when false>" < text
Prints the probability that the answer is true, then exits 0 for true (>= 0.5), 1 for false,
and 2 when Jev isn't available: no key, or the call failed. Treat 2 as "decide yourself".
The key comes from TYPESAFE_API_KEY, jev.api_key in ~/.config/team-floor/config.json, or
~/.config/typesafe/api-key. Only the last 1,500 characters of the text leave the machine, and
nothing does without a key.
"""
import json
import os
import sys
import urllib.request

URL = "https://api.typesafe.ai/v1/systemone"


def typesafe_key(problems=None):
    """TYPESAFE_API_KEY, then jev.api_key in ~/.config/team-floor/config.json, then the file named by
    jev.api_key_file (relative paths start in ~/.config/team-floor), by default ~/.config/typesafe/api-key.
    Returns "" when there's no usable key, and adds what went wrong to `problems`. Same lookup as the herdr
    hooks in kevinmanase/herdr-customizations."""
    problems = [] if problems is None else problems
    folder = os.path.expanduser("~/.config/team-floor")
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if not key:
        jev = {}
        try:
            with open(os.path.join(folder, "config.json"), encoding="utf-8") as handle:
                jev = json.load(handle).get("jev", {})
        except FileNotFoundError:
            pass
        except (OSError, ValueError, AttributeError) as error:
            problems.append(f"can't read {folder}/config.json ({type(error).__name__})")
        jev = jev if isinstance(jev, dict) else {}
        key = jev.get("api_key") if isinstance(jev.get("api_key"), str) else ""
        key = key.strip()
        named = jev.get("api_key_file")
        custom = isinstance(named, str) and bool(named)
        if named is not None and not custom:
            problems.append("jev.api_key_file in config.json must be a path")
        if not key:
            path = os.path.expanduser("~/.config/typesafe/api-key")
            if custom:
                path = os.path.join(folder, os.path.expanduser(named))
            try:
                with open(path, encoding="utf-8") as handle:
                    key = handle.read().strip()
            except FileNotFoundError:
                if custom:
                    problems.append(f"{path} doesn't exist")
            except (OSError, ValueError) as error:
                problems.append(f"can't read {path} ({type(error).__name__})")
    if key and (" " in key or not key.isprintable()):
        problems.append("the TypeSafe key has spaces or control characters, so it isn't used")
        return ""
    return key


def main() -> int:
    if len(sys.argv) != 4:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    question, when_true, when_false = sys.argv[1:]
    problems = []
    key = typesafe_key(problems)
    for problem in problems:
        print(f"jev: {problem}", file=sys.stderr)
    if not key:
        print("jev: no TypeSafe key; decide yourself", file=sys.stderr)
        return 2
    text = sys.stdin.read()[-1500:]
    body = {
        "state": text,
        "model": "jev-latest",
        "questions": {
            "answer": {
                "type": "noul",
                "instructions": question,
                "criteria": {"true": when_true, "false": when_false},
            }
        },
    }
    request = urllib.request.Request(
        URL,
        data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            probability = float(json.load(response)["answers"]["answer"]["noul"])
    except Exception as error:  # a failed router call must never block the work
        print(f"jev: unavailable ({error}); decide yourself", file=sys.stderr)
        return 2
    print(f"{probability:.2f}")
    return 0 if probability >= 0.5 else 1


if __name__ == "__main__":
    sys.exit(main())
